{
  "$defs": {
    "AcousticContext": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/AcousticStatus"
        },
        "coverage_label": {
          "minLength": 1,
          "title": "Coverage Label",
          "type": "string"
        },
        "conclusion": {
          "minLength": 1,
          "title": "Conclusion",
          "type": "string"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/AcousticObservation"
          },
          "title": "Observations",
          "type": "array"
        }
      },
      "required": [
        "status",
        "coverage_label",
        "conclusion"
      ],
      "title": "AcousticContext",
      "type": "object"
    },
    "AcousticObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "start_seconds": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Seconds"
        },
        "end_seconds": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Seconds"
        },
        "supporting_only": {
          "const": true,
          "default": true,
          "title": "Supporting Only",
          "type": "boolean"
        }
      },
      "required": [
        "observation_id",
        "label",
        "summary"
      ],
      "title": "AcousticObservation",
      "type": "object"
    },
    "AcousticStatus": {
      "enum": [
        "available",
        "limited",
        "unavailable"
      ],
      "title": "AcousticStatus",
      "type": "string"
    },
    "ActionExecution": {
      "enum": [
        "no_action",
        "automatic",
        "requires_approval"
      ],
      "title": "ActionExecution",
      "type": "string"
    },
    "ActionType": {
      "enum": [
        "none",
        "manager_review",
        "agent_coaching",
        "customer_follow_up",
        "policy_review"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "Applicability": {
      "additionalProperties": false,
      "properties": {
        "applies": {
          "title": "Applies",
          "type": "boolean"
        },
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "rule_id": {
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "selected_branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Branch"
        }
      },
      "required": [
        "applies",
        "profile_id",
        "rule_id",
        "reason"
      ],
      "title": "Applicability",
      "type": "object"
    },
    "CallDecision": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "evaluator_version": {
          "minLength": 1,
          "title": "Evaluator Version",
          "type": "string"
        },
        "domain_profile_id": {
          "minLength": 1,
          "title": "Domain Profile Id",
          "type": "string"
        },
        "signal_bundle_schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Signal Bundle Schema Version",
          "type": "string"
        },
        "signal_bundle_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signal Bundle Sha256"
        },
        "decision_status": {
          "$ref": "#/$defs/DecisionStatus"
        },
        "attention_required": {
          "title": "Attention Required",
          "type": "boolean"
        },
        "triggered_findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Triggered Findings",
          "type": "array"
        },
        "positive_findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Positive Findings",
          "type": "array"
        },
        "recommended_action": {
          "$ref": "#/$defs/RecommendedAction"
        },
        "uncertainties": {
          "items": {
            "$ref": "#/$defs/DecisionUncertainty"
          },
          "title": "Uncertainties",
          "type": "array"
        },
        "decision_trace": {
          "$ref": "#/$defs/DecisionPolicyTrace"
        },
        "presentation": {
          "$ref": "#/$defs/PresentationSelection"
        },
        "provenance": {
          "$ref": "#/$defs/SourceProvenance"
        }
      },
      "required": [
        "call_id",
        "evaluator_version",
        "domain_profile_id",
        "decision_status",
        "attention_required",
        "recommended_action",
        "decision_trace",
        "presentation",
        "provenance"
      ],
      "title": "CallDecision",
      "type": "object"
    },
    "CallEvaluationView": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "presentation_version": {
          "minLength": 1,
          "title": "Presentation Version",
          "type": "string"
        },
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "decision_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Decision Sha256",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/PageState"
        },
        "evaluation_status": {
          "$ref": "#/$defs/DecisionStatus"
        },
        "attention_required": {
          "title": "Attention Required",
          "type": "boolean"
        },
        "headline": {
          "minLength": 1,
          "title": "Headline",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "manager_questions": {
          "items": {
            "$ref": "#/$defs/ManagerQuestion"
          },
          "maxItems": 4,
          "title": "Manager Questions",
          "type": "array"
        },
        "checklist": {
          "items": {
            "$ref": "#/$defs/PresentedCheck"
          },
          "title": "Checklist",
          "type": "array"
        },
        "acoustic_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcousticContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "primary_reasons": {
          "items": {
            "$ref": "#/$defs/PresentedFinding"
          },
          "maxItems": 2,
          "title": "Primary Reasons",
          "type": "array"
        },
        "additional_reason_count": {
          "minimum": 0,
          "title": "Additional Reason Count",
          "type": "integer"
        },
        "positive_highlights": {
          "items": {
            "$ref": "#/$defs/PresentedFinding"
          },
          "maxItems": 2,
          "title": "Positive Highlights",
          "type": "array"
        },
        "additional_positive_count": {
          "minimum": 0,
          "title": "Additional Positive Count",
          "type": "integer"
        },
        "recommended_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/PresentedAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/PresentedEvidence"
          },
          "maxItems": 6,
          "title": "Evidence",
          "type": "array"
        },
        "completeness_notice": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompletenessNotice"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "details": {
          "$ref": "#/$defs/PresentationDetails"
        },
        "provenance": {
          "$ref": "#/$defs/SourceProvenance"
        }
      },
      "required": [
        "presentation_version",
        "call_id",
        "decision_sha256",
        "state",
        "evaluation_status",
        "attention_required",
        "headline",
        "summary",
        "additional_reason_count",
        "additional_positive_count",
        "details",
        "provenance"
      ],
      "title": "CallEvaluationView",
      "type": "object"
    },
    "CheckStatus": {
      "enum": [
        "demonstrated",
        "incorrect",
        "not_demonstrated",
        "unable_to_determine"
      ],
      "title": "CheckStatus",
      "type": "string"
    },
    "CompletenessNotice": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/DecisionStatus"
        },
        "title": {
          "const": "Evaluation incomplete",
          "default": "Evaluation incomplete",
          "title": "Title",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "affected_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Affected Requirements",
          "type": "array"
        }
      },
      "required": [
        "status",
        "message"
      ],
      "title": "CompletenessNotice",
      "type": "object"
    },
    "DecisionComparison": {
      "additionalProperties": false,
      "properties": {
        "comparable": {
          "title": "Comparable",
          "type": "boolean"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "attention_agreement": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attention Agreement"
        }
      },
      "required": [
        "comparable",
        "reason"
      ],
      "title": "DecisionComparison",
      "type": "object"
    },
    "DecisionPolicyTrace": {
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9_.-]+$",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "aggregation": {
          "const": "any_qualifying_finding",
          "title": "Aggregation",
          "type": "string"
        },
        "qualifications": {
          "items": {
            "$ref": "#/$defs/FindingQualification"
          },
          "title": "Qualifications",
          "type": "array"
        },
        "controlling_finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Controlling Finding Ids",
          "type": "array"
        },
        "recovery_finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Recovery Finding Ids",
          "type": "array"
        },
        "recovery_effect": {
          "$ref": "#/$defs/RecoveryEffect",
          "default": "none"
        }
      },
      "required": [
        "policy_id",
        "policy_version",
        "aggregation"
      ],
      "title": "DecisionPolicyTrace",
      "type": "object"
    },
    "DecisionStatus": {
      "enum": [
        "complete",
        "partial",
        "insufficient_evidence"
      ],
      "title": "DecisionStatus",
      "type": "string"
    },
    "DecisionUncertainty": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": "^[a-z0-9_.]+$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "modality": {
          "anyOf": [
            {
              "$ref": "#/$defs/Modality"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "affected_signal_ids": {
          "items": {
            "type": "string"
          },
          "title": "Affected Signal Ids",
          "type": "array"
        },
        "affected_finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Affected Finding Ids",
          "type": "array"
        },
        "visibility": {
          "$ref": "#/$defs/Visibility",
          "default": "details"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "DecisionUncertainty",
      "type": "object"
    },
    "DetectionRule": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "detector": {
          "minLength": 1,
          "title": "Detector",
          "type": "string"
        },
        "signal_ids": {
          "items": {
            "type": "string"
          },
          "title": "Signal Ids",
          "type": "array"
        },
        "thresholds": {
          "items": {
            "$ref": "#/$defs/ThresholdSpec"
          },
          "title": "Thresholds",
          "type": "array"
        }
      },
      "required": [
        "rule_id",
        "rule_version",
        "detector"
      ],
      "title": "DetectionRule",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "transcript",
        "audio_support",
        "business_context"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidencePurpose": {
      "enum": [
        "reason",
        "positive"
      ],
      "title": "EvidencePurpose",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "modality": {
          "$ref": "#/$defs/Modality"
        },
        "segment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Segment Ids",
          "type": "array"
        },
        "signal_ids": {
          "items": {
            "type": "string"
          },
          "title": "Signal Ids",
          "type": "array"
        },
        "episode_ids": {
          "items": {
            "type": "string"
          },
          "title": "Episode Ids",
          "type": "array"
        },
        "speaker": {
          "anyOf": [
            {
              "$ref": "#/$defs/Speaker"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "start_seconds": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Seconds"
        },
        "end_seconds": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Seconds"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "observation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation"
        }
      },
      "required": [
        "evidence_id",
        "modality"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "finding_type": {
          "minLength": 1,
          "pattern": "^[a-z0-9_.]+$",
          "title": "Finding Type",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/FindingCategory"
        },
        "polarity": {
          "$ref": "#/$defs/FindingPolarity"
        },
        "severity": {
          "$ref": "#/$defs/FindingSeverity"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "business_definition": {
          "minLength": 1,
          "title": "Business Definition",
          "type": "string"
        },
        "applicability": {
          "$ref": "#/$defs/Applicability"
        },
        "detection_rule": {
          "$ref": "#/$defs/DetectionRule"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "counter_evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Counter Evidence",
          "type": "array"
        },
        "reliability": {
          "$ref": "#/$defs/ReliabilityAssessment"
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        },
        "display_priority": {
          "default": 100,
          "minimum": 0,
          "title": "Display Priority",
          "type": "integer"
        }
      },
      "required": [
        "finding_id",
        "finding_type",
        "category",
        "polarity",
        "severity",
        "title",
        "summary",
        "business_definition",
        "applicability",
        "detection_rule",
        "evidence",
        "reliability",
        "visibility"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingCategory": {
      "enum": [
        "required_control",
        "process",
        "escalation",
        "outcome",
        "agent_behavior",
        "data_quality"
      ],
      "title": "FindingCategory",
      "type": "string"
    },
    "FindingOutcome": {
      "enum": [
        "effective",
        "incorrect",
        "missed",
        "observed_concern"
      ],
      "title": "FindingOutcome",
      "type": "string"
    },
    "FindingPolarity": {
      "enum": [
        "negative",
        "positive"
      ],
      "title": "FindingPolarity",
      "type": "string"
    },
    "FindingQualification": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "qualifies_for_attention": {
          "title": "Qualifies For Attention",
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/$defs/QualificationReason"
        },
        "precedence_group": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_.]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precedence Group"
        }
      },
      "required": [
        "finding_id",
        "qualifies_for_attention",
        "reason"
      ],
      "title": "FindingQualification",
      "type": "object"
    },
    "FindingSeverity": {
      "enum": [
        "info",
        "review",
        "critical"
      ],
      "title": "FindingSeverity",
      "type": "string"
    },
    "LegacyAttentionProxy": {
      "additionalProperties": false,
      "properties": {
        "evaluator_version": {
          "minLength": 1,
          "title": "Evaluator Version",
          "type": "string"
        },
        "attention_required": {
          "title": "Attention Required",
          "type": "boolean"
        },
        "basis": {
          "const": "failed_compliance_or_escalation",
          "title": "Basis",
          "type": "string"
        },
        "failed_compliance_count": {
          "minimum": 0,
          "title": "Failed Compliance Count",
          "type": "integer"
        },
        "escalation_tier": {
          "minLength": 1,
          "title": "Escalation Tier",
          "type": "string"
        }
      },
      "required": [
        "evaluator_version",
        "attention_required",
        "basis",
        "failed_compliance_count",
        "escalation_tier"
      ],
      "title": "LegacyAttentionProxy",
      "type": "object"
    },
    "ManagerAnswer": {
      "enum": [
        "yes",
        "partly",
        "no",
        "unclear"
      ],
      "title": "ManagerAnswer",
      "type": "string"
    },
    "ManagerQuestion": {
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "minLength": 1,
          "pattern": "^[a-z0-9_.]+$",
          "title": "Question Id",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "answer": {
          "$ref": "#/$defs/ManagerAnswer"
        },
        "answer_label": {
          "minLength": 1,
          "title": "Answer Label",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "question_id",
        "question",
        "answer",
        "answer_label",
        "summary"
      ],
      "title": "ManagerQuestion",
      "type": "object"
    },
    "Modality": {
      "enum": [
        "transcript",
        "text",
        "acoustic",
        "multimodal",
        "policy",
        "human"
      ],
      "title": "Modality",
      "type": "string"
    },
    "PageState": {
      "enum": [
        "needs_attention",
        "no_attention_finding",
        "evaluation_incomplete"
      ],
      "title": "PageState",
      "type": "string"
    },
    "PresentationDetails": {
      "additionalProperties": false,
      "properties": {
        "additional_findings": {
          "items": {
            "$ref": "#/$defs/PresentedFinding"
          },
          "title": "Additional Findings",
          "type": "array"
