{
  "$defs": {
    "AnnotationEvidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Evidence Id",
          "type": "string"
        },
        "segment_id": {
          "minLength": 1,
          "title": "Segment Id",
          "type": "string"
        },
        "seq_id": {
          "minimum": 0,
          "title": "Seq Id",
          "type": "integer"
        },
        "speaker": {
          "$ref": "#/$defs/Speaker"
        },
        "start_seconds": {
          "minimum": 0.0,
          "title": "Start Seconds",
          "type": "number"
        },
        "end_seconds": {
          "minimum": 0.0,
          "title": "End Seconds",
          "type": "number"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "segment_id",
        "seq_id",
        "speaker",
        "start_seconds",
        "end_seconds",
        "quote",
        "purpose"
      ],
      "title": "AnnotationEvidence",
      "type": "object"
    },
    "AnnotationProvenance": {
      "additionalProperties": false,
      "properties": {
        "annotator_id": {
          "minLength": 1,
          "title": "Annotator Id",
          "type": "string"
        },
        "annotator_type": {
          "$ref": "#/$defs/AnnotatorType"
        },
        "status": {
          "$ref": "#/$defs/AnnotationStatus"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "requires_human_review": {
          "title": "Requires Human Review",
          "type": "boolean"
        },
        "ground_truth_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ground Truth Basis"
        }
      },
      "required": [
        "annotator_id",
        "annotator_type",
        "status",
        "method",
        "requires_human_review"
      ],
      "title": "AnnotationProvenance",
      "type": "object"
    },
    "AnnotationStatus": {
      "enum": [
        "draft",
        "reviewed",
        "adjudicated"
      ],
      "title": "AnnotationStatus",
      "type": "string"
    },
    "AnnotatorType": {
      "enum": [
        "human",
        "model_assisted_researcher_seed",
        "synthetic_author"
      ],
      "title": "AnnotatorType",
      "type": "string"
    },
    "EvaluationSourceType": {
      "enum": [
        "existing_call",
        "controlled_challenge"
      ],
      "title": "EvaluationSourceType",
      "type": "string"
    },
    "ExpectedAttention": {
      "enum": [
        "required",
        "not_required",
        "uncertain"
      ],
      "title": "ExpectedAttention",
      "type": "string"
    },
    "ExpectedFindingLabel": {
      "additionalProperties": false,
      "properties": {
        "finding_type": {
          "minLength": 1,
          "pattern": "^[a-z0-9_.]+$",
          "title": "Finding Type",
          "type": "string"
        },
        "polarity": {
          "$ref": "#/$defs/FindingPolarity"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "finding_type",
        "polarity",
        "rationale"
      ],
      "title": "ExpectedFindingLabel",
      "type": "object"
    },
    "FindingPolarity": {
      "enum": [
        "negative",
        "positive"
      ],
      "title": "FindingPolarity",
      "type": "string"
    },
    "Speaker": {
      "enum": [
        "agent",
        "customer",
        "system",
        "unknown"
      ],
      "title": "Speaker",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "annotation_id": {
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Annotation Id",
      "type": "string"
    },
    "call_id": {
      "minLength": 1,
      "title": "Call Id",
      "type": "string"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "source_type": {
      "$ref": "#/$defs/EvaluationSourceType"
    },
    "expected_attention": {
      "$ref": "#/$defs/ExpectedAttention"
    },
    "expected_findings": {
      "items": {
        "$ref": "#/$defs/ExpectedFindingLabel"
      },
      "title": "Expected Findings",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/AnnotationEvidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "uncertainty_notes": {
      "items": {
        "type": "string"
      },
      "title": "Uncertainty Notes",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/AnnotationProvenance"
    }
  },
  "required": [
    "annotation_id",
    "call_id",
    "profile_id",
    "source_type",
    "expected_attention",
    "provenance"
  ],
  "title": "CallAnnotation",
  "type": "object"
}
