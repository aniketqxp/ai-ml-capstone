# Copy to .env and fill in. Real environment variables always override .env.

# ── LLM evaluation router (required for the evaluation graph) ────────────────
MISTRAL_API_KEY=          # primary   (mistral/mistral-small-latest)
SAMBANOVA_API_KEY=        # fallback  (Meta-Llama-3.3-70B-Instruct)
GITHUB_TOKEN=             # safety    (github/gpt-4o-mini)

# ── Optional extra providers (benchmark.py / llm_client.py registry) ─────────
OPENAI_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ID=
HUGGINGFACE_API_TOKEN=

# ── Database + storage (hosted deployment) ───────────────────────────────────
# Supabase Postgres: use the SESSION-POOLER (IPv4) URI, not the direct db host
# (Hugging Face Spaces has no IPv6 route to the direct host).
DATABASE_URL=
SUPABASE_URL=             # https://{project-ref}.supabase.co
SUPABASE_SERVICE_KEY=     # service-role key (storage writes)
SUPABASE_BUCKET=call-artifacts

# ── Acoustic sentiment stage ─────────────────────────────────────────────────
ENABLE_ACOUSTIC=0         # 1 = run wav2vec2 emotion inference on fresh calls
HF_TOKEN=                 # read access to the private model repo below
ACOUSTIC_MODEL_REPO=      # e.g. <user>/wav2vec2-emotion-v5
#ACOUSTIC_MODEL_DIR=      # local weights dir override

# ── Pipeline knobs ───────────────────────────────────────────────────────────
#WHISPER_MODEL=small.en

# ── Path roots (unset = local dev layout) ────────────────────────────────────
#CAPSTONE_DATA_ROOT=          # container: /home/user/workdata
#CAPSTONE_EVAL_RESULTS=
#CAPSTONE_FRONTEND_PUBLIC=
